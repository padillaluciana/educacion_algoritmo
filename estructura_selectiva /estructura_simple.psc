Algoritmo Estructuta_Simple
	//compara el menor de dos umeros reales 
	definir numero1, numero2 como real 
	Escribir "ingresar el primer numero";
	leer numero1;
	escribir "ingresar el segundo numero";
	leer numero2;
	//determinar el menor .
	si numero1 < numero2 entonces 
		escribir "el menor es:",numero1;
	FinSi
	si numero2 < numero1 Entonces
		mostrar "el menor es:",numero2;
	FinSi
	
FinAlgoritmo
